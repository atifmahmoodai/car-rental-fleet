# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# docker-compose builds DATABASE_URL from POSTGRES_PASSWORD. Outside Docker set it yourself:
# DATABASE_URL=postgres://rental:PASSWORD@localhost:5432/rental

# --- Web ---
# The address customers use (https in production). Used in email links and the CSRF origin check.
PUBLIC_URL=http://localhost:8080
# Behind nginx / Caddy / a cloud load balancer that terminates https (needed for correct client IPs,
# which the booking rate limit relies on):
TRUST_PROXY=false
# Secure cookies need https. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
NODE_ENV=production
APP_PORT=8080

# Time zone of the rental desks (IANA name). Every pick-up and return time customers enter and see
# is in this zone, whatever their own device is set to. It also decides "today" in reports.
TIMEZONE=America/New_York

# --- Email (optional) ---
# Without SMTP_URL no emails are sent (they are only logged). Format: smtp(s)://user:pass@host:port
# SMTP_URL=smtps://apikey:SECRET@smtp.example.com:465
MAIL_FROM=Rentals <no-reply@example.com>
# Also send each new online booking to the desk:
# BOOKING_NOTIFY_EMAIL=desk@example.com

# --- Sessions ---
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=12

LOG_LEVEL=info
RATE_LIMIT_PER_MIN=300
